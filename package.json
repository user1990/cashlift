{
	"name": "kuvro",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check",
		"lint:fix": "biome check --write src",
		"check:react": "mv react-doctor.config.json react-doctor.config.json.bak && npx react-doctor . --offline; mv react-doctor.config.json.bak react-doctor.config.json",
		"typecheck": "tsgo --noEmit",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install chromium",
		"security:audit": "pnpm audit --prod --audit-level high",
		"security:check": "node scripts/security-check.mjs",
		"check:code": "fallow --only dupes && fallow --only dead-code",
		"check:code:fix": "fallow fix --dry-run",
		"prepare": "lefthook install",
		"doctor": "npx react-doctor@latest"
	},
	"dependencies": {
		"@clerk/nextjs": "^7.3.2",
		"@hookform/resolvers": "^5.4.0",
		"@sentry/nextjs": "^10",
		"@supabase/ssr": "^0.12.0",
		"@supabase/supabase-js": "^2.108.2",
		"@tanstack/react-query": "^5.101.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"cnfast": "^0.0.8",
		"date-fns": "^4.4.0",
		"lucide-react": "^1.14.0",
		"motion": "^12.40.0",
		"next": "16.2.9",
		"next-intl": "^4.13.0",
		"react": "19.2.7",
		"react-aria-components": "^1.18.0",
		"react-dom": "19.2.7",
		"react-hook-form": "^7.79.0",
		"recharts": "^3.8.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.3",
		"@biomejs/biome": "^2.5.0",
		"@playwright/test": "^1.61.0",
		"@tailwindcss/postcss": "^4.3.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^22",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@typescript/native-preview": "7.0.0-dev.20260421.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"fallow": "^2.69.0",
		"jsdom": "^29.1.1",
		"lefthook": "^2.1.9",
		"tailwindcss": "^4.3.1",
		"turbopack-inline-svg-loader": "^1.0.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	},
	"engines": {
		"node": ">=22.13"
	},
	"packageManager": "pnpm@11.7.0"
}
