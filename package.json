{
	"name": "cashlift",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"docs:dev": "blume dev",
		"docs:build": "blume build",
		"docs:preview": "blume preview",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"lint": "biome check --unsafe",
		"lint:fix": "biome check --write src",
		"check:react": "npx react-doctor@latest --verbose",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "pnpm test:e2e:demo && pnpm test:e2e:production",
		"test:e2e:demo": "env -u NO_COLOR playwright test",
		"test:e2e:install": "playwright install chromium --with-deps",
		"test:e2e:production": "env -u NO_COLOR playwright test --config playwright.production.config.ts",
		"security:audit": "pnpm audit --prod --audit-level high",
		"security:check": "node scripts/security-check.mjs",
		"check:code": "fallow --only dupes && fallow --only dead-code",
		"check:code:fix": "fallow fix --dry-run",
		"prepare": "lefthook install",
		"doctor": "npx react-doctor@latest"
	},
	"dependencies": {
		"@clerk/nextjs": "^7.6.1",
		"@hookform/resolvers": "^5.5.7",
		"@internationalized/date": "3.12.2",
		"@sentry/nextjs": "^10.68.0",
		"@supabase/ssr": "^0.12.3",
		"@supabase/supabase-js": "^2.110.8",
		"@tanstack/react-query": "^5.101.4",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"cnfast": "^0.0.8",
		"date-fns": "^4.4.0",
		"lucide-react": "^1.27.0",
		"motion": "^12.42.2",
		"next": "16.3.0",
		"next-intl": "^4.13.4",
		"nuqs": "2.9.2",
		"react": "19.2.8",
		"react-aria-components": "^1.19.0",
		"react-dom": "19.2.8",
		"react-hook-form": "^7.83.0",
		"recharts": "^3.10.1",
		"sonner": "^2.0.7",
		"tailwind-variants": "^3.3.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@astrojs/mdx": "7.0.3",
		"@astrojs/react": "6.0.1",
		"@axe-core/playwright": "^4.12.1",
		"@biomejs/biome": "^2.5.5",
		"@next/playwright": "16.3.0",
		"@playwright/test": "^1.62.0",
		"@shikijs/twoslash": "4.3.1",
		"@storybook/addon-docs": "^10.5.5",
		"@storybook/addon-mcp": "^0.7.0",
		"@storybook/nextjs-vite": "^10.5.5",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/coverage-v8": "^4.1.10",
		"astro": "7.1.3",
		"babel-plugin-react-compiler": "^1.0.0",
		"blume": "1.2.0",
		"fallow": "^3.9.1",
		"jsdom": "^30.0.0",
		"lefthook": "^2.1.10",
		"msw": "^2.15.0",
		"shadcn": "^4.15.0",
		"storybook": "^10.5.5",
		"tailwindcss": "^4.3.3",
		"turbopack-inline-svg-loader": "^1.0.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=24 <25"
	},
	"packageManager": "pnpm@11.7.0"
}
