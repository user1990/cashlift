{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false
	},
	"plugins": [
		"./.biome/jsx-sibling-newlines.grit",
		{
			"path": "./.biome/jsx-prop-order.grit",
			"includes": ["**/modules/marketing/**/*.tsx"]
		},
		"./.biome/security-sensitive-browser-apis.grit"
	],
	"overrides": [
		{
			"includes": ["public/*.svg"],
			"linter": {
				"rules": {
					"a11y": {
						"noSvgWithoutTitle": "off"
					}
				}
			}
		}
	],
	"formatter": {
		"lineWidth": 120
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"security": {
				"noSecrets": {
					"level": "error",
					"options": { "entropyThreshold": 50 }
				}
			},
			"correctness": {
				"useExhaustiveDependencies": "error"
			},
			"complexity": {
				"noExcessiveCognitiveComplexity": "warn",
				"noExtraBooleanCast": "off",
				"useOptionalChain": "error"
			},
			"performance": {
				"noBarrelFile": "warn"
			},
			"style": {
				"useConsistentArrowReturn": "error",
				"noNonNullAssertion": "error",
				"useImportType": "error",
				"useConsistentArrayType": {
					"level": "error",
					"options": { "syntax": "shorthand" }
				}
			},
			"suspicious": {
				"noDuplicatedSpreadProps": "error",
				"noDuplicateTestHooks": "error",
				"noFocusedTests": "error",
				"noSkippedTests": "error",
				"noUnknownAttribute": "error",
				"noDocumentCookie": "error"
			},
			"nursery": {
				"noInlineStyles": "warn",
				"useSortedClasses": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
